# Local development values only. Copy this file to .env and choose your own
# password. Never commit .env or reuse local credentials in AWS.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=ecommerce_dw
POSTGRES_USER=ecommerce_etl
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional. When set, this takes precedence over the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ecommerce_dw

# AWS settings are intentionally unused in Phase 1.
AWS_REGION=ap-south-1
S3_BUCKET=
SSM_PARAMETER_PREFIX=/aws-ecommerce-etl/dev
